<body>

    <!-- MAIN PAGE -->

    <div class="container">

        <div class="card">

            <!-- TITLE -->

            <h1>📚 Study vs Instagram 📱</h1>

            <p class="subtitle">
                Compare your study time with your Instagram time
            </p>


            <!-- STUDY INPUT -->

            <div class="input-box">

                <label for="studyTime">
                    📚 Study Time (Hours)
                </label>

                <input
                    type="number"
                    id="studyTime"
                    placeholder="Enter study hours"
                    min="0"
                    step="0.5"
                >

            </div>


            <!-- INSTAGRAM INPUT -->

            <div class="input-box">

                <label for="instaTime">
                    📱 Instagram Time (Hours)
                </label>

                <input
                    type="number"
                    id="instaTime"
                    placeholder="Enter Instagram hours"
                    min="0"
                    step="0.5"
                >

            </div>


            <!-- BUTTON -->

            <button onclick="calculateTime()">
                Compare My Time
            </button>


            <!-- RESULT SECTION -->

            <div class="result" id="result">

                <h2>📊 Your Result</h2>

                <p id="studyResult"></p>

                <p id="instaResult"></p>

                <p id="totalResult"></p>

                <p id="studyPercentage"></p>

                <p id="instaPercentage"></p>

                <div class="message" id="message"></div>

            </div>


            <!-- CASE STUDY -->

            <div class="case-study">

                <h3>📖 About This Case Study</h3>

                <p>
                    This calculator helps students compare the amount of
                    time they spend studying with the amount of time they
                    spend on Instagram.
                </p>

            </div>

        </div>

    </div>


    <!-- =========================
         JAVASCRIPT
    ========================= -->

    <script>

        function calculateTime() {

            // Get input values

            let study = parseFloat(
                document.getElementById("studyTime").value
            );

            let insta = parseFloat(
                document.getElementById("instaTime").value
            );


            // Validate input

            if (
                isNaN(study) ||
                isNaN(insta) ||
                study < 0 ||
                insta < 0
            ) {

                alert("Please enter valid time values.");

                return;
            }


            // Calculate total time

            let totalTime = study + insta;


            // Prevent division by zero

            if (totalTime === 0) {

                alert("Please enter at least one time value.");

                return;
            }


            // Calculate percentages

            let studyPercentage =
                (study / totalTime) * 100;

            let instaPercentage =
                (insta / totalTime) * 100;


            // Display study time

            document.getElementById("studyResult").innerHTML =
                "📚 Study Time: <b>" +
                study +
                " hours</b>";


            // Display Instagram time

            document.getElementById("instaResult").innerHTML =
                "📱 Instagram Time: <b>" +
                insta +
                " hours</b>";


            // Display total time

            document.getElementById("totalResult").innerHTML =
                "⏱️ Total Time: <b>" +
                totalTime +
                " hours</b>";


            // Display study percentage

            document.getElementById("studyPercentage").innerHTML =
                "📚 Study Percentage: <b>" +
                studyPercentage.toFixed(1) +
                "%</b>";


            // Display Instagram percentage

            document.getElementById("instaPercentage").innerHTML =
                "📱 Instagram Percentage: <b>" +
                instaPercentage.toFixed(1) +
                "%</b>";


            // Compare both times

            let message;


            if (study > insta) {

                message =
                    "📚 Great! Your study time is higher than your Instagram time.";

            }

            else if (insta > study) {

                message =
                    "📱 Your Instagram time is higher than your study time.";

            }

            else {

                message =
                    "⚖️ Your study time and Instagram time are equal.";

            }


            // Display message

            document.getElementById("message").innerHTML =
                message;


            // Show result

            document.getElementById("result").style.display =
                "block";
        }

    </script>

</body>

</html>
